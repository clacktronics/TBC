// Tang Nano 20K (GW2AR-LV18QN88C8/I7) - stage 1 pinout
//
// Matches the carrier board in hardware/tbc_carrier: the ADC signals are on
// the left header row (header pins 1-14, USB-C end = pin 1), except adc_d[0]
// on header pin 21 (right row, opposite pin 20). Some of these
// also run to the RGB-LCD FPC connector, so don't fit an LCD at the same
// time. FPGA pins 32-40 are not on the header (33-40 drive the HDMI port).

IO_LOC "clk27" 4;
IO_PORT "clk27" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "btn_rst" 88;
IO_PORT "btn_rst" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

IO_LOC "uart_tx" 69;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33;

// MS9280 data (D9 = MSB), in ADC pin order down the header so the board
// tracks fan out without crossing.
// adc_d[9:2] are also an AD9280's D7..D0; its pins 3-4 are NC, so the two
// LSBs are pulled down to read 0 with that part fitted.
IO_LOC "adc_d[0]" 52;
IO_LOC "adc_d[1]" 31;
IO_LOC "adc_d[2]" 30;
IO_LOC "adc_d[3]" 29;
IO_LOC "adc_d[4]" 26;
IO_LOC "adc_d[5]" 25;
IO_LOC "adc_d[6]" 28;
IO_LOC "adc_d[7]" 27;
IO_LOC "adc_d[8]" 77;
IO_LOC "adc_d[9]" 85;
IO_PORT "adc_d[0]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_PORT "adc_d[1]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_PORT "adc_d[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "adc_d[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "adc_d[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "adc_d[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "adc_d[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "adc_d[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "adc_d[8]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "adc_d[9]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "adc_otr" 75;
IO_PORT "adc_otr" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "adc_clk" 74;
IO_PORT "adc_clk" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "adc_clamp" 73;
IO_PORT "adc_clamp" IO_TYPE=LVCMOS33 DRIVE=8;

// onboard LEDs (active low)
IO_LOC "led[0]" 15;
IO_LOC "led[1]" 16;
IO_LOC "led[2]" 17;
IO_LOC "led[3]" 18;
IO_LOC "led[4]" 19;
IO_LOC "led[5]" 20;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led[5]" IO_TYPE=LVCMOS33 DRIVE=8;
